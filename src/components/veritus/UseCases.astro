---
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';
import Button from './Button.astro';
import { getAsset, getPermalink } from '~/utils/permalinks';

const images = {
  operations: '/assets/images/operations-intake-routing.webp',
  document: '/assets/images/document-processing-system.webp',
  support: '/assets/images/support-automation-queue.webp',
  sales: '/assets/images/sales-operations-crm.webp',
  knowledge: '/assets/images/knowledge-system-retrieval.webp',
  pipeline: '/assets/images/production-automation-pipeline-hd.webp',
};

const useCases = [
  [
    'Operations intake',
    'Classify requests, collect context, route work, and prepare the next action.',
    '/examples#operations-intake',
    'Human review before assignment rules expand.',
    images.operations,
  ],
  [
    'Document processing',
    'Extract fields, validate exceptions, and move approved records into business systems.',
    '/campaigns/document-processing',
    'Reviewer confirms flagged fields and exceptions.',
    images.document,
  ],
  [
    'Support automation',
    'Triage tickets, draft responses, detect urgency, and keep human approval in the loop.',
    '/campaigns/support-automation',
    'Support lead approves sensitive replies.',
    images.support,
  ],
  [
    'Sales operations',
    'Qualify inbound interest, summarize accounts, and prepare cleaner CRM updates.',
    '/campaigns/sales-automation',
    'Sales owner reviews enrichment and next steps.',
    images.sales,
  ],
  [
    'Knowledge systems',
    'Create assistants that answer from approved business context and show their sources.',
    '/examples#knowledge-systems',
    'Unclear answers route to source owners.',
    images.knowledge,
  ],
  [
    'Pipeline orchestration',
    'Connect events, tools, data, approvals, and logs into one operating flow.',
    '/capabilities#automated-pipelines',
    'Approvals protect downstream records.',
    images.pipeline,
  ],
] as const;
---

<Section id="use-cases" tone="soft">
  <SectionHeader
    eyebrow="Use cases"
    title="Automation patterns with enough structure to launch responsibly."
    subtitle="Veritus focuses on repeated workflows where better coordination, review, and system updates can remove daily operational friction."
  />
  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {
      useCases.map(([title, description, href, review, image], index) => (
        <article class="vt-card vt-card-link flex min-h-[380px] flex-col p-5">
          <div>
            <div class="vt-card-media">
              <img src={getAsset(image)} alt="" loading="lazy" decoding="async" />
            </div>
            <div class="mb-6 flex h-10 w-10 items-center justify-center rounded-full border border-secondary/20 bg-secondary/5 text-sm font-semibold text-secondary dark:border-secondary/25 dark:bg-secondary/10">
              {String(index + 1).padStart(2, '0')}
            </div>
            <h3 class="text-lg font-semibold text-heading">{title}</h3>
            <p class="mt-3 text-sm leading-6 text-muted">{description}</p>
            <div class="mt-5 border-t border-gray-200 pt-4 dark:border-white/10">
              <p class="text-xs font-semibold text-heading">Review point</p>
              <p class="mt-1 text-xs leading-5 text-muted">{review}</p>
            </div>
          </div>
          <Button href={getPermalink(href)} variant="link" class="vt-arrow mt-6 text-sm" text="View pattern" />
        </article>
      ))
    }
  </div>
</Section>
