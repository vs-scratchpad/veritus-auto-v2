---
import PageHero from './PageHero.astro';
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';
import FinalCta from './FinalCta.astro';
import ImagePanel from './ImagePanel.astro';
import { getPermalink } from '~/utils/permalinks';

export interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  outcomes: Array<[string, string]>;
  workflow: Array<[string, string]>;
  imageVariant?:
    | 'documentProcessing'
    | 'governedAgent'
    | 'supportAutomation'
    | 'salesOperations'
    | 'operationsIntake'
    | 'knowledgeSystem'
    | 'integrationSurface';
  imageAlt?: string;
  ctaTitle?: string;
  ctaSubtitle?: string;
}

const { eyebrow, title, subtitle, outcomes, workflow, imageVariant, imageAlt, ctaTitle, ctaSubtitle } = Astro.props;
---

<PageHero
  eyebrow={eyebrow}
  title={title}
  subtitle={subtitle}
  primaryText="Discuss this Workflow"
  primaryHref={getPermalink('/contact')}
  secondaryText="Explore Solutions"
  secondaryHref={getPermalink('/capabilities')}
/>

<Section>
  <SectionHeader
    eyebrow="First system version"
    title="What the first version should make clear."
    subtitle="A focused workflow should explain the operating improvement, the review point, and the first useful deliverable."
  />
  <div class:list={['grid gap-8', imageVariant ? 'lg:grid-cols-[1.05fr_0.95fr] lg:items-center' : '']}>
    {imageVariant && <ImagePanel variant={imageVariant} alt={imageAlt ?? ''} />}
    <div class:list={['grid gap-4 md:grid-cols-3', imageVariant ? 'lg:grid-cols-1' : '']}>
      {
        outcomes.map(([title, description]) => (
          <article class="vt-card p-6">
            <h2 class="text-lg font-semibold text-heading">{title}</h2>
            <p class="mt-3 text-sm leading-6 text-muted">{description}</p>
          </article>
        ))
      }
    </div>
  </div>
</Section>

<Section tone="soft">
  <SectionHeader
    eyebrow="Workflow shape"
    title="The automation path stays visible."
    subtitle="Each step is designed so teams can inspect what the system did and where a person should stay involved."
  />
  <div class="grid gap-4">
    {
      workflow.map(([title, description], index) => (
        <article class="vt-card grid gap-4 p-5 md:grid-cols-[80px_0.55fr_1fr]">
          <p class="text-sm font-semibold text-secondary">{String(index + 1).padStart(2, '0')}</p>
          <h2 class="text-base font-semibold text-heading">{title}</h2>
          <p class="text-sm leading-6 text-muted">{description}</p>
        </article>
      ))
    }
  </div>
</Section>

<FinalCta title={ctaTitle} subtitle={ctaSubtitle} />
