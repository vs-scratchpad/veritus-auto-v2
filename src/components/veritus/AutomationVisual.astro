---
const queue = [
  ['New request', 'Classified from intake form', 'Ready'],
  ['Policy summary', 'AI-prepared draft with sources', 'Review'],
  ['CRM update', 'Fields mapped from approved notes', 'Queued'],
];

const systems = ['CRM', 'Docs', 'Support', 'Database'];

const activity = [
  ['Context collected', '5 sources linked'],
  ['Draft prepared', '2 exceptions flagged'],
  ['Reviewer assigned', 'Operations owner'],
];

const flowNodes = [
  {
    title: 'Intake',
    detail: 'Request captured',
    x: '6%',
    y: '8%',
  },
  {
    title: 'Context model',
    detail: 'Sources linked',
    x: '52%',
    y: '8%',
  },
  {
    title: 'Agent draft',
    detail: 'Action prepared',
    x: '6%',
    y: '36%',
  },
  {
    title: 'Human review',
    detail: 'Approval routed',
    x: '52%',
    y: '36%',
  },
  {
    title: 'System update',
    detail: 'Records staged',
    x: '6%',
    y: '64%',
  },
  {
    title: 'Audit trail',
    detail: 'Evidence logged',
    x: '52%',
    y: '64%',
  },
];
---

<div
  class="vt-panel relative mx-auto w-full max-w-6xl overflow-hidden bg-white dark:bg-[#10141a]"
  aria-label="Veritus automation workspace visual"
>
  <div class="flex items-center justify-between border-b border-gray-200 px-4 py-3 dark:border-white/10">
    <div class="flex items-center gap-2">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ff6b5f]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#f6c350]"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#35c46a]"></span>
    </div>
    <div class="text-xs font-medium text-muted">Veritus automation workspace</div>
  </div>

  <div class="grid lg:grid-cols-[0.9fr_1.25fr_0.8fr]">
    <div class="border-b border-gray-200 p-5 dark:border-white/10 sm:p-6 lg:border-b-0 lg:border-r">
      <p class="vt-eyebrow">Agent console</p>
      <h2 class="mt-2 text-2xl font-semibold leading-tight text-heading">Operations request pipeline</h2>
      <p class="mt-3 text-sm leading-6 text-muted">
        Intake is classified, useful context is gathered, and sensitive updates wait for approval.
      </p>

      <div class="mt-6 space-y-3">
        {
          queue.map(([title, detail, status], index) => (
            <div class="rounded-lg border border-gray-200 bg-white p-4 transition duration-300 hover:border-gray-300 dark:border-white/10 dark:bg-white/[0.035] dark:hover:border-white/20">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <div class="flex items-center gap-2">
                    <span class="flex h-6 w-6 items-center justify-center rounded-full border border-gray-200 bg-white text-xs font-semibold text-heading dark:border-white/10 dark:bg-black/20">
                      {index + 1}
                    </span>
                    <h3 class="text-sm font-semibold text-heading">{title}</h3>
                  </div>
                  <p class="mt-2 text-sm leading-6 text-muted">{detail}</p>
                </div>
                <span class="rounded-full border border-gray-200 bg-white px-2.5 py-1 text-xs font-medium text-gray-700 dark:border-white/10 dark:bg-white/[0.04] dark:text-gray-300">
                  {status}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <div
      class="relative min-h-[370px] overflow-hidden border-b border-gray-200 bg-[#fbfbfc] p-5 text-heading dark:border-white/10 dark:bg-white/[0.025] sm:p-6 lg:border-x lg:border-b-0"
    >
      <div class="relative flex items-center justify-between gap-4">
        <div>
          <p class="text-sm font-semibold text-muted">Automation control surface</p>
          <h3 class="mt-2 text-xl font-semibold">Reviewable automation flow</h3>
        </div>
        <span
          class="rounded-full border border-gray-200 bg-white px-3 py-1 text-xs font-medium text-muted dark:border-white/10 dark:bg-white/[0.04]"
        >
          Live draft
        </span>
      </div>

      <div
        class="relative mt-6 min-h-[360px] overflow-hidden rounded-lg border border-gray-200 bg-white p-4 shadow-[inset_0_1px_0_rgba(255,255,255,0.75)] dark:border-white/10 dark:bg-white/[0.035] sm:min-h-[340px] sm:p-5"
        aria-label="Reviewable automation flow from intake to audit trail"
      >
        <div
          class="absolute inset-x-4 top-4 flex items-center justify-between rounded-md border border-gray-200 bg-[#fbfbfc] px-3 py-2 dark:border-white/10 dark:bg-white/[0.035] sm:inset-x-5"
        >
          <span class="text-xs font-semibold text-heading">Flow state</span>
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-muted">
            <span class="h-1.5 w-1.5 rounded-full bg-secondary"></span>
            Review enabled
          </span>
        </div>

        <svg
          class="pointer-events-none absolute inset-x-4 bottom-4 top-14 h-auto w-[calc(100%-2rem)] text-gray-300 dark:text-white/20 sm:inset-x-5 sm:bottom-5 sm:top-16 sm:w-[calc(100%-2.5rem)]"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <defs>
            <marker id="flow-arrow" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="4" markerHeight="4" orient="auto">
              <path d="M1 1 L7 4 L1 7 Z" fill="currentColor"></path>
            </marker>
          </defs>
          <path d="M48 18 H52" fill="none" stroke="currentColor" stroke-width="0.45" marker-end="url(#flow-arrow)">
          </path>
          <path
            d="M73 26 C73 34 27 34 27 38"
            fill="none"
            stroke="currentColor"
            stroke-width="0.45"
            marker-end="url(#flow-arrow)"
          >
          </path>
          <path d="M48 46 H52" fill="none" stroke="currentColor" stroke-width="0.45" marker-end="url(#flow-arrow)">
          </path>
        </svg>

        <div class="absolute inset-x-4 bottom-4 top-16 sm:inset-x-5 sm:bottom-5 sm:top-20">
          {
            flowNodes.map(({ title, detail, x, y }) => (
              <article
                class="absolute w-[42%] rounded-lg border border-gray-200 bg-white p-3 shadow-[0_12px_34px_rgba(15,23,42,0.055)] dark:border-white/10 dark:bg-[#11161d]"
                style={`left: ${x}; top: ${y};`}
              >
                <div class="flex items-center gap-2">
                  <span class="h-2 w-2 shrink-0 rounded-full bg-secondary" />
                  <p class="min-w-0 text-xs font-semibold leading-4 text-heading">{title}</p>
                </div>
                <p class="mt-1 text-[11px] leading-4 text-muted">{detail}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div class="mt-4 grid grid-cols-3 gap-2">
        {
          ['Retrieve', 'Classify', 'Prepare'].map((item) => (
            <div class="rounded-md border border-gray-200 bg-white px-3 py-2 text-center text-xs font-semibold text-muted dark:border-white/10 dark:bg-white/[0.035]">
              {item}
            </div>
          ))
        }
      </div>
    </div>

    <div class="p-5 sm:p-6">
      <div class="flex items-center justify-between gap-3">
        <p class="text-sm font-semibold text-heading">Connected tools</p>
        <span class="h-2 w-2 rounded-full bg-secondary"></span>
      </div>
      <div class="mt-4 grid grid-cols-2 gap-3">
        {
          systems.map((system) => (
            <div class="rounded-lg border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-white/[0.035]">
              <p class="text-sm font-semibold text-heading">{system}</p>
              <div class="mt-4 h-1.5 overflow-hidden rounded-full bg-gray-200 dark:bg-white/10">
                <div class="h-full w-2/3 rounded-full bg-gray-950 dark:bg-white" />
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-5 rounded-lg border border-gray-200 bg-white p-4 dark:border-white/10 dark:bg-white/[0.035]">
        <p class="text-sm font-semibold text-heading">Review queue</p>
        <div class="mt-4 space-y-3">
          {
            activity.map(([title, detail]) => (
              <div class="flex items-center justify-between gap-3 rounded-md border border-gray-200 bg-white px-3 py-3 dark:border-white/10 dark:bg-white/[0.035]">
                <div>
                  <p class="text-sm font-medium text-heading">{title}</p>
                  <p class="mt-1 text-xs text-muted">{detail}</p>
                </div>
                <span class="h-2 w-2 rounded-full bg-secondary" />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>
