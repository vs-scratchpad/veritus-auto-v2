---
const labels = ['AI workflow design', 'Software systems', 'Tool integrations', 'Human review', 'Automated pipelines'];
---

<section class="not-prose border-y border-gray-200 bg-[#f8f9fa] dark:border-white/10 dark:bg-[#101318]">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-6 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8"
  >
    <p class="vt-eyebrow">Built for operational teams turning repeated work into systems</p>
    <div class="flex flex-wrap gap-2">
      {labels.map((label) => <span class="vt-chip text-xs">{label}</span>)}
    </div>
  </div>
</section>
