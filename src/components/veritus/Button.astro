---
import { twMerge } from 'tailwind-merge';

export interface Props {
  href?: string;
  text?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'link';
  class?: string;
  target?: string;
  type?: 'button' | 'submit' | 'reset';
  ariaLabel?: string;
}

const {
  href,
  text = await Astro.slots.render('default'),
  variant = 'secondary',
  class: className = '',
  target,
  type = 'button',
  ariaLabel,
  ...rest
} = Astro.props;

const base =
  'inline-flex min-h-11 items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold leading-none transition duration-200 hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-gray-950/15 focus-visible:ring-offset-2 focus-visible:ring-offset-white disabled:pointer-events-none disabled:opacity-50 dark:focus-visible:ring-white/20 dark:focus-visible:ring-offset-black';

const variants = {
  primary:
    'border border-gray-950 bg-gray-950 text-white shadow-[0_14px_34px_rgba(15,23,42,0.12)] hover:bg-gray-800 hover:border-gray-800 hover:shadow-[0_18px_42px_rgba(15,23,42,0.16)] dark:border-white dark:bg-white dark:text-gray-950 dark:shadow-none dark:hover:bg-gray-200',
  secondary:
    'border border-gray-300 bg-white text-gray-950 hover:border-gray-950 hover:shadow-[0_14px_34px_rgba(15,23,42,0.08)] dark:border-white/15 dark:bg-white/5 dark:text-white dark:hover:border-white/35 dark:hover:shadow-none',
  ghost:
    'border border-transparent bg-transparent text-gray-700 hover:bg-gray-100 hover:text-gray-950 dark:text-gray-300 dark:hover:bg-white/10 dark:hover:text-white',
  link: 'min-h-0 rounded-none border border-transparent bg-transparent px-0 py-0 text-gray-950 underline-offset-4 hover:underline dark:text-white',
};

const classes = twMerge(base, variants[variant], className);
---

{
  href ? (
    <a
      href={href}
      class={classes}
      aria-label={ariaLabel}
      {...(target ? { target, rel: 'noopener noreferrer' } : {})}
      {...rest}
    >
      <Fragment set:html={text} />
    </a>
  ) : (
    <button type={type} class={classes} aria-label={ariaLabel} {...rest}>
      <Fragment set:html={text} />
    </button>
  )
}
