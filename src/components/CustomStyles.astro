---
import '@fontsource-variable/geist';
---

<style is:inline>
  :root {
    --aw-font-sans: 'Geist Variable';
    --aw-font-serif: 'Geist Variable';
    --aw-font-heading: 'Geist Variable';

    --aw-color-primary: rgb(12 14 18);
    --aw-color-secondary: rgb(0 102 204);
    --aw-color-accent: rgb(0 102 204);

    --aw-color-text-heading: rgb(10 12 16);
    --aw-color-text-default: rgb(32 36 43);
    --aw-color-text-page: rgb(32 36 43);
    --aw-color-text-muted: rgb(100 106 116);
    --aw-color-bg-page: rgb(255 255 255);
    --aw-color-bg-page-dark: rgb(8 10 13);

    --vt-color-surface: rgb(250 250 251);
    --vt-color-surface-strong: rgb(245 245 247);
    --vt-color-border: rgb(226 228 233);
    --vt-color-border-strong: rgb(199 205 216);
    --vt-color-ink: rgb(10 12 16);
    --vt-color-line: rgb(207 214 226);
    --vt-shadow-soft: 0 24px 80px rgb(15 23 42 / 8%);
    --vt-shadow-card: 0 18px 50px rgb(15 23 42 / 6%);

    ::selection {
      background-color: rgb(219 234 254);
      color: rgb(10 12 16);
    }
  }

  .dark {
    --aw-font-sans: 'Geist Variable';
    --aw-font-serif: 'Geist Variable';
    --aw-font-heading: 'Geist Variable';

    --aw-color-primary: rgb(247 248 250);
    --aw-color-secondary: rgb(118 174 255);
    --aw-color-accent: rgb(118 174 255);

    --aw-color-text-heading: rgb(247 248 250);
    --aw-color-text-default: rgb(224 229 237);
    --aw-color-text-page: rgb(224 229 237);
    --aw-color-text-muted: rgb(157 164 176);
    --aw-color-bg-page: rgb(8 10 13);
    --aw-color-bg-page-dark: rgb(8 10 13);

    --vt-color-surface: rgb(13 16 20);
    --vt-color-surface-strong: rgb(22 26 33);
    --vt-color-border: rgb(39 45 56);
    --vt-color-border-strong: rgb(64 72 88);
    --vt-color-ink: rgb(247 248 250);
    --vt-color-line: rgb(65 74 89);
    --vt-shadow-soft: none;
    --vt-shadow-card: none;

    ::selection {
      background-color: rgb(45 85 189);
      color: white;
    }
  }
</style>
