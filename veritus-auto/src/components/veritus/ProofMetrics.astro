---
import Section from './Section.astro';
import SectionHeader from './SectionHeader.astro';

const metrics = [
  ['Cycle time', 'How long repeated workflow steps take before and after the system.'],
  ['Correction rate', 'How often AI-prepared drafts need edits before approval.'],
  ['Exception volume', 'Where ambiguous cases appear and how quickly they are routed.'],
  ['System coverage', 'Which tools, data sources, records, and approvals are connected.'],
];
---

<Section id="proof" tone="white">
  <div class="vt-panel bg-white p-6 dark:bg-white/[0.035] md:p-8 lg:p-10">
    <SectionHeader
      eyebrow="Results measurement"
      title="Measure the workflow before claiming the outcome."
      subtitle="When real client or pilot data is available, Veritus can publish outcomes using practical workflow evidence instead of vague automation claims."
      class="mb-8"
    />
    <div class="grid gap-4 md:grid-cols-4">
      {
        metrics.map(([title, description]) => (
          <div class="rounded-md border border-gray-200 bg-white p-5 transition duration-300 hover:-translate-y-0.5 hover:border-gray-300 dark:border-white/10 dark:bg-white/[0.035] dark:hover:border-white/20">
            <p class="text-xl font-semibold text-heading">{title}</p>
            <p class="mt-3 text-sm leading-6 text-muted">{description}</p>
          </div>
        ))
      }
    </div>
  </div>
</Section>
