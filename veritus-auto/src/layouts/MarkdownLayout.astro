---
import Layout from '~/layouts/PageLayout.astro';

import type { MetaData } from '~/types';

export interface Props {
  frontmatter: {
    title?: string;
  };
}

const { frontmatter } = Astro.props;

const metadata: MetaData = {
  title: frontmatter?.title,
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-4xl px-5 py-16 sm:px-6 lg:px-8 lg:py-20">
    <h1 class="font-heading text-4xl font-semibold leading-tight text-heading md:text-5xl">{frontmatter.title}</h1>
    <div
      class="prose prose-lg mt-8 max-w-4xl prose-headings:font-heading prose-headings:font-semibold prose-headings:text-heading prose-a:text-secondary prose-img:rounded-md dark:prose-invert dark:prose-headings:text-white dark:prose-a:text-secondary"
    >
      <slot />
    </div>
  </section>
</Layout>
