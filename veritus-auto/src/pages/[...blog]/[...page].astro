---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';

import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/veritus/PageHero.astro';
import Section from '~/components/veritus/Section.astro';
import Button from '~/components/veritus/Button.astro';

import { blogListRobots, getStaticPathsBlogList } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogList({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;
const currentPage = page.currentPage ?? 1;

const metadata = {
  title: `Resources${currentPage > 1 ? ` - Page ${currentPage}` : ''}`,
  robots: {
    index: blogListRobots?.index && currentPage === 1,
    follow: blogListRobots?.follow,
  },
  openGraph: {
    type: 'blog',
  },
};
---

<Layout metadata={metadata}>
  <PageHero
    eyebrow="Resources"
    title="Original notes for AI automation planning."
    subtitle="Short Veritus resources for workflow readiness, human review, governance, and practical agent-assisted operations."
  />

  <Section>
    <div class="grid gap-4">
      {
        page.data.map((post) => (
          <article class="vt-card p-6">
            <p class="vt-eyebrow">{post.category?.title || 'Resource'}</p>
            <h2 class="mt-4 text-2xl font-semibold leading-tight text-heading">{post.title}</h2>
            {post.excerpt && <p class="mt-3 max-w-3xl text-sm leading-6 text-muted">{post.excerpt}</p>}
            <div class="mt-6">
              <Button href={getPermalink(post.permalink, 'post')} variant="link" text="Read resource" />
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      {page.url.prev && <Button href={page.url.prev} text="Previous" />}
      {page.url.next && <Button href={page.url.next} text="Next" />}
    </div>
  </Section>
</Layout>
